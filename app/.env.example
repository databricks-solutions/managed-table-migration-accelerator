DATABRICKS_HOST=https://...
DATABRICKS_WAREHOUSE_ID=your_sql_warehouse_id
# No DATABRICKS_GENIE_SPACE_ID: the Genie space id is read at boot from the
# migration_control_config handshake row, not the environment (see server/config/control-config.ts).
DATABRICKS_APP_PORT=8000
DATABRICKS_APP_NAME=managed-table-migration
FLASK_RUN_HOST=0.0.0.0

# Migration control-plane target. MIGRATION_CATALOG is REQUIRED and has no default —
# an unset value crashes at startup naming this variable. MIGRATION_SCHEMA defaults to
# 'migration' if unset. Deployed runs get both from config.env in app/resources/app.yml;
# local dev reads them from app/.env (copy these values there).
MIGRATION_CATALOG=main
MIGRATION_SCHEMA=migration
