{
  "_doc": "Golden cases for migration.authority.evaluate. The c*/m*/co* cases are the live scratch matrix (two workspaces: DBSQL 2026.38 and 2026.39, serverless SQL warehouses, 2026-10-08) with principals anonymized; `observed` is what SET MANAGED did with exactly these facts. e* cases are derived edges. Grants are [securable_level, privilege, grantee]. Each expected request pins its grantors and the verbatim ask_text every interface renders.",
  "cases": [
    {
      "id": "c0_data_only",
      "observed": "FAIL: User is not an owner of Table",
      "facts": {
        "full_name": "main_cat.sch_a.c0", "actor": "migration-sp",
        "table_owner": "data-owner@example.com", "schema_owner": "data-owner@example.com", "catalog_owner": "catalog-admins",
        "actor_groups": [], "metastore_admin": false, "reads_ok": true,
        "grants": [["CATALOG", "USE CATALOG", "migration-sp"], ["SCHEMA", "USE SCHEMA", "migration-sp"],
                   ["TABLE", "SELECT", "migration-sp"], ["TABLE", "MODIFY", "migration-sp"]]
      },
      "expected": {
        "status": "NEEDS_GRANT", "basis": null, "basis_via": null, "missing": ["OWNER_OR_MANAGE"], "self_grantable": false,
        "requests": [
          {"privilege": "MANAGE", "securable_type": "TABLE", "securable_name": "main_cat.sch_a.c0", "self_grantable": false,
           "grantors": ["data-owner@example.com", "catalog-admins"],
           "ask_text": "Ask the owner of table `main_cat.sch_a.c0` (`data-owner@example.com`) to run: GRANT MANAGE ON TABLE main_cat.sch_a.c0 TO `migration-sp`; or ask any principal with MANAGE on it, or a metastore admin."}
        ]
      }
    },
