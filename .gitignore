# Databricks Asset Bundle local state (also self-ignored via .databricks/.gitignore)
.databricks/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Notebooks
.ipynb_checkpoints/

# OS / editor
.DS_Store
*.swp
.idea/

# Local environment: .env and any .env.<name>, except the tracked *.example templates
.env
.env.*
!.env*.example

# Do not add a `*conf*.json` pattern: it would untrack app/tsconfig*.json.

# Local working notes / agent tool artifacts (kept locally, out of the repo)
cursor_prompts.md
*.plan.md
.cursor/
.superpowers/
.isaac/
.claude/

# Superpowers plans/specs and dated design plans (local working notes, not part of the repo)
backend/docs/superpowers/
docs/superpowers/
app/docs/plans/

# Local bundle targets (see the include in databricks.yml)
databricks.local*.yml

.worktrees/

# e2e UI screenshots (e2e_app_ui.py --screenshots)
backend/.e2e/artifacts/
