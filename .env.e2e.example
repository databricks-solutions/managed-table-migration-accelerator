# Settings for the live e2e estate (backend/.e2e) and the `e2e` bundle target.
# Copy to .env.e2e (git-ignored), fill in, then load it into your shell:
#   set -a; source .env.e2e; set +a
#   databricks bundle deploy -t e2e --profile "$DATABRICKS_CONFIG_PROFILE"

# Databricks CLI profile for the e2e workspace (never auto-selected).
DATABRICKS_CONFIG_PROFILE=

# Bundle variables for `-t e2e` (read by `databricks bundle` as BUNDLE_VAR_<name>).
BUNDLE_VAR_manifest_catalog=
BUNDLE_VAR_catalog_filter=
BUNDLE_VAR_dataset_catalog=
BUNDLE_VAR_warehouse_id=
BUNDLE_VAR_workspace_id=
BUNDLE_VAR_e2e_external_base=
# Optional extra catalog.schema for the synthetic fixture seeder (built-in: mtm_e2e_dev.migration).
BUNDLE_VAR_e2e_fixture_control_plane=

# The same values for the .e2e driver scripts.
E2E_WAREHOUSE_ID=
E2E_CATALOG=
E2E_EXTERNAL_BASE=
E2E_BUNDLE_TARGET=e2e
